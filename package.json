{
  "name": "qa-platform",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "extract-zip@2.0.1>yauzl": "3.4.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "repository:check": "node scripts/check-repository-hygiene.mjs",
    "distribution:build": "node scripts/distribution/build.mjs",
    "distribution:test": "node --test scripts/distribution/tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.21.5",
    "eslint": "catalog:",
    "prettier": "^3.3.3",
    "turbo": "^2.4.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
