{
  "name": "@qa/harness-opencode",
  "version": "0.1.0",
  "type": "module",
  "description": "Sentry OpenCode harness adapter (OpenRouter provider path). CLI-driven, no vendor SDK dependency.",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qa/domain": "workspace:*",
    "@qa/evidence-pipeline": "workspace:*",
    "@qa/harness-protocol": "workspace:*",
    "@qa/schemas": "workspace:*",
    "@qa/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@qa/persistence": "workspace:*",
    "@qa/project-manager": "workspace:*",
    "@qa/run-engine": "workspace:*",
    "@qa/snapshot-engine": "workspace:*",
    "@qa/workspace-factory": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
