{
  "name": "@qa/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sentry desktop QA workspace (Electron + React). Phase 8.",
  "main": "dist/main/index.js",
  "build": {
    "productName": "Sentry",
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/sentry-icon.ico"
    },
    "mac": {
      "icon": "assets/sentry-icon.icns"
    },
    "linux": {
      "icon": "assets/sentry-icon.png"
    }
  },
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json && node scripts/fix-preload.mjs",
    "build:renderer": "vite build",
    "dev": "vite --port 5174",
    "dev:electron": "electron .",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:main && npm run typecheck:preload && npm run typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "smoke": "vitest run tests/smoke",
    "smoke:electron": "electron --headless scripts/electron-smoke.mjs",
    "test:electron": "playwright test --config playwright.electron.config.ts"
  },
  "dependencies": {
    "@qa/domain": "workspace:*",
    "@qa/harness-claude-code": "workspace:*",
    "@qa/harness-deepseek": "workspace:*",
    "@qa/harness-protocol": "workspace:*",
    "@qa/merger": "workspace:*",
    "@qa/persistence": "workspace:*",
    "@qa/project-manager": "workspace:*",
    "@qa/run-engine": "workspace:*",
    "@qa/runtime-protocol": "workspace:*",
    "@qa/schemas": "workspace:*",
    "@qa/shared": "workspace:*",
    "@qa/verifier": "workspace:*",
    "@tanstack/react-query": "5.62.7",
    "@xyflow/react": "12.3.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zod": "catalog:",
    "zustand": "5.0.2",
    "lucide-react": "0.469.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.1.0",
    "@types/node": "catalog:",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "36.2.1",
    "electron-builder": "26.0.12",
    "eslint": "catalog:",
    "jsdom": "26.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "5.4.21",
    "vitest": "catalog:"
  }
}
